{
  "name": "dhw-rnw",
  "version": "0.0.1",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "repo:fix": "sherif --fix",
    "build": "bun --filter vite-plugin-rnw build",
    "example": "bun --filter rnw-example dev",
    "changeset": "changeset",
    "version-packages": "changeset version && bun install --lockfile-only",
    "release": "bun run build && changeset publish",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "bun run --workspaces --if-present typecheck"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.74.0",
    "sherif": "^1.13.0"
  },
  "private": true,
  "packageManager": "bun@1.3.14"
}
