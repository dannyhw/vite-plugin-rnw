{
  "name": "dhw-rnw",
  "version": "0.0.1",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "repo:fix": "sherif --fix",
    "build": "bun --filter vite-plugin-rnw build",
    "example": "bun --filter rnw-example dev",
    "lint": "bun --filter rnw-example lint",
    "lint:fix": "bun --filter rnw-example lint:fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "devDependencies": {
    "oxfmt": "^0.59.0",
    "sherif": "^1.13.0"
  },
  "private": true,
  "packageManager": "bun@1.3.14"
}
